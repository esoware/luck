{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lua",
  "scopeName": "source.lua",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#members"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#groups"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "\\A#!.*$",
          "name": "comment.line.shebang.lua"
        },
        {
          "name": "comment.block.lua",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lua"
            }
          },
          "patterns": [
            {
              "include": "#documentation"
            }
          ]
        },
        {
          "name": "comment.line.documentation.lua",
          "begin": "---",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lua"
            }
          },
          "patterns": [
            {
              "include": "#documentation"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.lua",
          "begin": "--",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lua"
            }
          }
        }
      ]
    },
    "documentation": {
      "patterns": [
        {
          "match": "(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.annotation.lua"
            },
            "2": {
              "name": "variable.parameter.lua"
            }
          }
        },
        {
          "match": "@[A-Za-z_][A-Za-z0-9_]*",
          "name": "storage.type.annotation.lua"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lua",
          "begin": "\"",
          "end": "\"|(?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lua"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.lua",
          "begin": "'",
          "end": "'|(?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lua"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.multiline.lua",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lua"
            }
          }
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.lua",
          "begin": "\\\\z",
          "end": "(?=\\S)"
        },
        {
          "match": "\\\\(?:[0-9]{1,3}|x[\\da-fA-F]{2}|u\\{[\\da-fA-F]+\\}|\\r?\\n|.)",
          "name": "constant.character.escape.lua"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX](?:[\\da-fA-F]+(?:\\.(?!\\.)[\\da-fA-F]*)?|\\.[\\da-fA-F]+)(?:[pP][+-]?\\d+)?",
          "name": "constant.numeric.hex.lua"
        },
        {
          "match": "(?<![\\w.])(?:\\d+(?:\\.(?!\\.)\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?",
          "name": "constant.numeric.lua"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:and|or|not)\\b",
          "name": "keyword.operator.wordlike.lua keyword.operator.expression.lua"
        },
        {
          "match": "\\b(?:if|then|else|elseif)\\b",
          "name": "keyword.control.conditional.lua"
        },
        {
          "match": "\\b(?:for|while|repeat|until|in|do|break)\\b",
          "name": "keyword.control.loop.lua"
        },
        {
          "match": "\\b(?:return|end)\\b",
          "name": "keyword.control.flow.lua"
        },
        {
          "match": "\\blocal\\b",
          "name": "storage.type.lua"
        },
        {
          "match": "\\bglobal\\b(?=\\s+function\\b)",
          "name": "storage.type.lua"
        },
        {
          "match": "\\b(?:true|false|nil)\\b",
          "name": "constant.language.lua"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.this.lua"
        },
        {
          "include": "#rest"
        }
      ]
    },
    "rest": {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.rest.lua"
    },
    "declarations": {
      "patterns": [
        {
          "include": "#labels"
        },
        {
          "include": "#function"
        },
        {
          "name": "meta.declaration.lua",
          "begin": "\\b(local|global(?=\\s+(?:[A-Za-z_][A-Za-z0-9_]*|\\*)))\\b(?!\\s+function\\b)",
          "end": "(?==|;|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|const|continue)\\b)|(?<![,])(?=$)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#attribute"
            },
            {
              "include": "#binding"
            },
            {
              "include": "#comma"
            }
          ],
          "beginCaptures": {
            "1": {
              "name": "storage.type.lua"
            }
          }
        }
      ]
    },
    "function-assignment": {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*=\\s*function\\b)",
      "name": "entity.name.function.lua"
    },
    "function-call": {
      "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:[({'\"]|\\[=*\\[))",
      "name": "entity.name.function.lua"
    },
    "binding": {
      "patterns": [
        {
          "include": "#function-assignment"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]*\\b",
          "name": "variable.other.constant.lua"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.readwrite.lua"
        }
      ]
    },
    "function": {
      "name": "meta.function.lua",
      "begin": "\\bfunction\\b",
      "end": "(?<=\\))|(?=\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameters"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*[.:])",
          "name": "variable.other.object.lua"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.lua"
        },
        {
          "match": "[.:]",
          "name": "punctuation.accessor.lua"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "storage.type.function.lua"
        }
      }
    },
    "parameters": {
      "name": "meta.parameters.lua",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.begin.lua"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.lua"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#rest"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.parameter.lua"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.lua"
        }
      ]
    },
    "members": {
      "name": "meta.member.lua",
      "begin": "\\.(?!\\.)|:",
      "end": "(?<=\\w)|(?=[^\\sA-Za-z_\\-])",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#function-call"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]*\\b",
          "name": "variable.other.constant.property.lua"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.property.lua"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.accessor.lua"
        }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "include": "#function-call"
        },
        {
          "include": "#binding"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "<<|>>",
          "name": "keyword.operator.bitwise.lua"
        },
        {
          "match": "==|~=|<=|>=|<|>",
          "name": "keyword.operator.comparison.lua"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.lua"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.concatenation.lua"
        },
        {
          "match": "//|[+*/%^\\-]",
          "name": "keyword.operator.arithmetic.lua"
        },
        {
          "match": "#",
          "name": "keyword.operator.length.lua"
        },
        {
          "match": "[&|~]",
          "name": "keyword.operator.bitwise.lua"
        }
      ]
    },
    "groups": {
      "patterns": [
        {
          "name": "meta.group.lua",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.lua"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.index.lua",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.lua"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.object-literal.lua",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.lua"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.lua"
            }
          },
          "patterns": [
            {
              "include": "#function-assignment"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*(?=\\s*=(?!=))",
              "name": "variable.other.property.lua"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "comma": {
      "match": ",",
      "name": "punctuation.separator.comma.lua"
    },
    "punctuation": {
      "patterns": [
        {
          "include": "#comma"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.lua"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.lua"
            },
            "2": {
              "name": "entity.name.label.lua"
            },
            "3": {
              "name": "punctuation.definition.label.lua"
            }
          }
        },
        {
          "match": "\\b(goto)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.flow.lua"
            },
            "2": {
              "name": "entity.name.label.lua"
            }
          }
        }
      ]
    },
    "attribute": {
      "match": "(<)\\s*(const|close)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.lua"
        },
        "2": {
          "name": "storage.modifier.lua"
        },
        "3": {
          "name": "punctuation.definition.attribute.lua"
        }
      }
    }
  }
}
