{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luau",
  "scopeName": "source.luau",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declare"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#cast"
    },
    {
      "include": "#return-annotation"
    },
    {
      "include": "#instantiation"
    },
    {
      "include": "#attribute-list"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#members"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#groups"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "\\A#!.*$",
          "name": "comment.line.shebang.luau"
        },
        {
          "name": "comment.block.luau",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.luau"
            }
          },
          "patterns": [
            {
              "include": "#documentation"
            }
          ]
        },
        {
          "name": "comment.line.documentation.luau",
          "begin": "---",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.luau"
            }
          },
          "patterns": [
            {
              "include": "#documentation"
            }
          ]
        },
        {
          "name": "comment.line.double-dash.luau",
          "begin": "--",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.luau"
            }
          }
        }
      ]
    },
    "documentation": {
      "patterns": [
        {
          "match": "(@param)\\s+([A-Za-z_][A-Za-z0-9_]*+)",
          "captures": {
            "1": {
              "name": "storage.type.annotation.luau"
            },
            "2": {
              "name": "variable.parameter.luau"
            }
          }
        },
        {
          "include": "#attribute"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.luau",
          "begin": "\"",
          "end": "\"|(?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luau"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.luau",
          "begin": "'",
          "end": "'|(?=\\n)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luau"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.multiline.luau",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luau"
            }
          }
        },
        {
          "include": "#template"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.luau",
          "begin": "\\\\z",
          "end": "(?=\\S)"
        },
        {
          "match": "\\\\(?:[0-9]{1,3}|x[\\da-fA-F]{2}|u\\{[\\da-fA-F]+\\}|\\r?\\n|.)",
          "name": "constant.character.escape.luau"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0_*[xX][\\da-fA-F_]+\\b",
          "name": "constant.numeric.hex.luau"
        },
        {
          "match": "\\b0_*[bB][01_]+\\b",
          "name": "constant.numeric.binary.luau"
        },
        {
          "match": "(?:(?<![\\w.])|(?<=\\.\\.))(?:\\d[\\d_]*(?:\\.(?!\\.)[\\d_]*)?|\\.\\d[\\d_]*)(?:[eE][+-]?[\\d_]+)?(?!\\w)",
          "name": "constant.numeric.luau"
        },
        {
          "match": "\\b\\d\\w*",
          "name": "constant.numeric.luau"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:and|or|not)\\b",
          "name": "keyword.operator.wordlike.luau keyword.operator.expression.luau"
        },
        {
          "match": "\\b(?:if|then|else|elseif)\\b",
          "name": "keyword.control.conditional.luau"
        },
        {
          "match": "\\b(?:while|repeat|until|in|do|break)\\b",
          "name": "keyword.control.loop.luau"
        },
        {
          "match": "\\b(?:return|end)\\b",
          "name": "keyword.control.flow.luau"
        },
        {
          "match": "\\bcontinue\\b(?=\\s*(?:--|$|;|\\b(?:end|until|else|elseif)\\b))",
          "name": "keyword.control.loop.luau"
        },
        {
          "match": "\\blocal\\b",
          "name": "storage.type.luau"
        },
        {
          "match": "\\bconst\\b(?=\\s+function\\b)",
          "name": "storage.type.luau"
        },
        {
          "match": "\\bexport\\b(?=\\s+(?:local|const|function)\\b)",
          "name": "keyword.control.export.luau"
        },
        {
          "include": "#language-constant"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.this.luau"
        },
        {
          "include": "#rest"
        }
      ]
    },
    "language-constant": {
      "match": "\\b(?:true|false|nil)\\b",
      "name": "constant.language.luau"
    },
    "rest": {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.rest.luau"
    },
    "declarations": {
      "patterns": [
        {
          "include": "#type-function"
        },
        {
          "include": "#type-alias"
        },
        {
          "include": "#function"
        },
        {
          "name": "meta.loop.variables.luau",
          "begin": "\\bfor\\b",
          "end": "(?==|\\bin\\b|\\b(?:do|end|local|function|return|if|while|repeat|until)\\b)|(?<![,])(?=$)|^",
          "patterns": [
            {
              "include": "#declaration-names"
            }
          ],
          "beginCaptures": {
            "0": {
              "name": "keyword.control.loop.luau"
            }
          }
        },
        {
          "name": "meta.declaration.luau",
          "begin": "\\b(?:(export)\\s+)?(local|const(?=\\s+(?!(?:and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b)[A-Za-z_]))\\b(?!\\s+function\\b)",
          "end": "(?==|;|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|const|continue)\\b)|(?<![,])(?=$)|^",
          "patterns": [
            {
              "include": "#declaration-names"
            }
          ],
          "beginCaptures": {
            "1": {
              "name": "keyword.control.export.luau"
            },
            "2": {
              "name": "storage.type.luau"
            }
          }
        }
      ]
    },
    "function-assignment": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*+(?=\\s*=\\s*function\\b)",
      "name": "entity.name.function.luau"
    },
    "function-call": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*+(?=\\s*(?:[({'\"`]|\\[=*\\[|<<[^\\n]*>>))",
      "name": "entity.name.function.luau"
    },
    "binding": {
      "patterns": [
        {
          "include": "#function-assignment"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]*\\b",
          "name": "variable.other.constant.luau"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*+",
          "name": "variable.other.readwrite.luau"
        }
      ]
    },
    "declaration-names": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#binding"
        },
        {
          "begin": "(,)(?=\\s*(?:--.*)?$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.comma.luau"
            }
          },
          "end": "(?=[^\\s-]|-(?!-))",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "include": "#comma"
        }
      ]
    },
    "function": {
      "name": "meta.function.luau",
      "begin": "\\bfunction\\b",
      "end": "(?<=\\))|(?=\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function)\\b)",
      "patterns": [
        {
          "include": "#function-head"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "storage.type.function.luau"
        }
      }
    },
    "function-head": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#generics"
        },
        {
          "include": "#parameters"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*+(?=\\s*[.:])",
          "name": "variable.other.object.luau"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*+",
          "name": "entity.name.function.luau"
        },
        {
          "match": "[.:]",
          "name": "punctuation.accessor.luau"
        }
      ]
    },
    "parameters": {
      "name": "meta.parameters.luau",
      "begin": "\\(",
      "end": "\\)|(?=\\b(?:and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.begin.luau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.luau"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#rest"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*+",
          "name": "variable.parameter.luau"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.luau"
        }
      ]
    },
    "members": {
      "name": "meta.member.luau",
      "begin": "\\.(?!\\.)|:(?!:)",
      "end": "(?<=\\w)|(?=[^\\sA-Za-z_\\-])|(?=\\b(?:and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#function-call"
        },
        {
          "match": "\\b[A-Z][A-Z0-9_]*\\b",
          "name": "variable.other.constant.property.luau"
        },
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*+",
          "name": "variable.other.property.luau"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.accessor.luau"
        }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "include": "#function-call"
        },
        {
          "include": "#binding"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\+=|-=|\\*=|//=|/=|%=|\\^=|\\.\\.=",
          "name": "keyword.operator.assignment.compound.luau"
        },
        {
          "match": "==|~=|<=|>=|<|>",
          "name": "keyword.operator.comparison.luau"
        },
        {
          "include": "#assignment"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.concatenation.luau"
        },
        {
          "match": "//|[+*/%^\\-]",
          "name": "keyword.operator.arithmetic.luau"
        },
        {
          "match": "#",
          "name": "keyword.operator.length.luau"
        }
      ]
    },
    "assignment": {
      "match": "=",
      "name": "keyword.operator.assignment.luau"
    },
    "groups": {
      "patterns": [
        {
          "name": "meta.group.luau",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.group.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.group.end.luau"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.index.luau",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.luau"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.object-literal.luau",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.luau"
            }
          },
          "patterns": [
            {
              "include": "#function-assignment"
            },
            {
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*+(?=\\s*=(?!=))",
              "name": "variable.other.property.luau"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "comma": {
      "match": ",",
      "name": "punctuation.separator.comma.luau"
    },
    "punctuation": {
      "patterns": [
        {
          "include": "#comma"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.luau"
        }
      ]
    },
    "template": {
      "name": "string.template.luau",
      "begin": "`",
      "end": "`|(?=\\n)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.begin.luau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.luau"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "meta.template.expression.luau",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.luau"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.luau"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ],
          "contentName": "meta.embedded.line.luau"
        }
      ]
    },
    "type-function": {
      "name": "meta.function.luau",
      "begin": "\\b(?:(export)\\s+)?(type)\\s+(function)\\b",
      "end": "(?<=\\))|(?=\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function)\\b)",
      "patterns": [
        {
          "include": "#function-head"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.luau"
        },
        "2": {
          "name": "storage.type.luau"
        },
        "3": {
          "name": "storage.type.function.luau"
        }
      }
    },
    "type-alias": {
      "name": "meta.type.declaration.luau",
      "begin": "\\b(?:(export)\\s+)?(type)\\s+(?!(?:and|break|do|else|elseif|end|false|for|function|if|in|local|nil|not|or|repeat|return|then|true|until|while)\\b)([A-Za-z_][A-Za-z0-9_]*+)\\b",
      "end": "(?=[,;)}\\]]|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|continue|const)\\b|[+*/%^#]|-(?![->])|~=|==|\\.\\.(?!\\.))|^(?!\\s*(?:[|&]|->|--))|(?<=[\\w)>?}\\]'\\\"])(?<!->)\\s+(?=(?!typeof\\b)[A-Za-z_][A-Za-z0-9_]*+(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*+)*\\s*(?:[=(\\[{'\"`]|:\\s*[A-Za-z_]|[+*/%^-]=|//=|\\.\\.=))",
      "patterns": [
        {
          "begin": "(=)(?=\\s*(?:--.*)?$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.assignment.luau"
            }
          },
          "end": "(?=[^\\s-]|-(?!-))",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "include": "#assignment"
        },
        {
          "include": "#types"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.luau"
        },
        "2": {
          "name": "storage.type.luau"
        },
        "3": {
          "name": "entity.name.type.alias.luau"
        }
      }
    },
    "annotation": {
      "name": "meta.type.annotation.luau",
      "begin": ":(?!:)",
      "end": "(?=[,;)=}\\]]|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|continue|const)\\b|[+*/%^#]|-(?![->])|~=|==|\\.\\.(?!\\.))|^(?!\\s*(?:[|&]|->|--))|(?<=[\\w)>?}\\]'\\\"])(?<!->)\\s+(?=(?!typeof\\b)[A-Za-z_][A-Za-z0-9_]*+(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*+)*\\s*(?:[=(\\[{'\"`]|:\\s*[A-Za-z_]|[+*/%^-]=|//=|\\.\\.=))",
      "patterns": [
        {
          "include": "#type-line-continuation"
        },
        {
          "include": "#types"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.type.luau"
        }
      }
    },
    "return-annotation": {
      "name": "meta.type.annotation.luau",
      "begin": "(?<=\\))\\s*(:)(?!:|\\s*(?!typeof\\b)[A-Za-z_][A-Za-z0-9_]*+(?=\\s*(?:[({'\"`]|\\[=*\\[|<<)))",
      "end": "(?=[,;)=}\\]]|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|continue|const)\\b|[+*/%^#]|-(?![->])|~=|==|\\.\\.(?!\\.))|^(?!\\s*(?:[|&]|->|--))|(?<=[\\w)>?}\\]'\\\"])(?<!->)\\s+(?=(?!typeof\\b)[A-Za-z_][A-Za-z0-9_]*+(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*+)*\\s*(?:[=(\\[{'\"`]|:\\s*[A-Za-z_]|[+*/%^-]=|//=|\\.\\.=))",
      "patterns": [
        {
          "include": "#type-line-continuation"
        },
        {
          "include": "#types"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.type.luau"
        }
      }
    },
    "cast": {
      "name": "meta.type.cast.luau",
      "begin": "::",
      "end": "(?=[,;)=}\\]]|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function|continue|const)\\b|[+*/%^#]|-(?![->])|~=|==|\\.\\.(?!\\.))|^(?!\\s*(?:[|&]|->|--))|(?<=[\\w)>?}\\]'\\\"])(?<!->)\\s+(?=(?!typeof\\b)[A-Za-z_][A-Za-z0-9_]*+(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*+)*\\s*(?:[=(\\[{'\"`]|:\\s*[A-Za-z_]|[+*/%^-]=|//=|\\.\\.=))|(?=>|<=|<(?![^\\n]*(?:>|[,<{(]\\s*(?:--.*)?$)|\\s*(?:--.*)?$))|(?=::)",
      "patterns": [
        {
          "include": "#type-line-continuation"
        },
        {
          "include": "#types"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.cast.luau"
        }
      }
    },
    "generics": {
      "name": "meta.type.parameters.luau",
      "begin": "<(?!<)",
      "end": ">|(?=\\b(?:and|break|do|else|elseif|end|for|function|if|in|local|not|or|repeat|return|then|until|while)\\b)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.luau"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.luau"
        }
      },
      "patterns": [
        {
          "include": "#assignment"
        },
        {
          "include": "#types"
        }
      ]
    },
    "instantiation": {
      "name": "meta.type.arguments.luau",
      "begin": "<<(?=[^\\n]*>>)",
      "end": ">>|(?=[;=]|\\b(?:and|or|not|if|then|else|elseif|end|do|while|for|in|repeat|until|break|return|local|function)\\b)|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.luau"
        }
