{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LuckConfig",
  "description": "Top-level luck.json configuration.",
  "type": "object",
  "properties": {
    "dynamic_require": {
      "description": "How the bundler treats a `require` whose argument isn't a string\nliteral: `\"error\"`, `\"warn\"` (default), or `\"allow\"`.",
      "anyOf": [
        {
          "$ref": "#/$defs/DynamicRequire"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/EntryConfig"
      }
    },
    "entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "exclude": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "format": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormatConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "include": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "lint": {
      "anyOf": [
        {
          "$ref": "#/$defs/LintConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "lua": {
      "description": "Dialect for `.lua` files (default `lua54`). Any dialect is accepted:\nRoblox and Rojo trees that keep Luau in `.lua` files set\n`\"lua\": \"roblox\"` or `\"lua\": \"luau\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "luau": {
      "description": "Dialect for `.luau` files (default `luau`). Any dialect is accepted.",
      "type": [
        "string",
        "null"
      ]
    },
    "luck_preamble": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "minify": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "preamble": {
      "type": [
        "string",
        "null"
      ]
    },
    "profiles": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/ProfileOverrides"
      }
    },
    "root": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "search_paths": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "transforms": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransformConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BlockNewlineGaps": {
      "description": "Whether a block body can start or end with a blank line.",
      "oneOf": [
        {
          "description": "Strip blank lines at the start and end of every block body.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Keep one blank line at the start or end of a block body when the source\nhas any there.",
          "type": "string",
          "const": "preserve"
        }
      ]
    },
    "CallParentheses": {
      "description": "When a call drops the parentheses around a lone string or table argument.",
      "oneOf": [
        {
          "description": "Always use parentheses: `f(\"hello\")`, `f({1, 2})`.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Omit parentheses for a single string argument: `f \"hello\"`.",
          "type": "string",
          "const": "no_single_string"
        },
        {
          "description": "Omit parentheses for a single table argument: `f {1, 2}`.",
          "type": "string",
          "const": "no_single_table"
        },
        {
          "description": "Omit parentheses for single string or table arguments.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Keep the source's choice: `f\"x\"` stays bare and `f(\"x\")` keeps its\nparentheses.",
          "type": "string",
          "const": "input"
        }
      ]
    },
    "CategoryLevels": {
      "description": "The level of each rule category that sets one.",
      "type": "object",
      "properties": {
        "correctness": {
          "description": "Outright wrong or useless code.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "performance": {
          "description": "Performance improvements.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "description": "Idiomatic code style.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "suspicious": {
          "description": "Most likely wrong or useless.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "CollapseSimpleStatement": {
      "description": "Which simple single-statement blocks collapse onto one line. Function\nbodies never do.",
      "oneOf": [
        {
          "description": "Always expand blocks.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Collapse simple conditionals: `if x then return y end`.",
          "type": "string",
          "const": "conditional_only"
        }
      ]
    },
    "CyclomaticComplexityOptions": {
      "description": "Options of the `cyclomatic_complexity` rule.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Complexity above which a function is flagged.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max"
      ]
    },
    "DynamicRequire": {
      "description": "How the bundler treats a `require` whose argument isn't a string literal\nand so can't be resolved at build time.",
      "oneOf": [
        {
          "description": "Fail the bundle (E002).",
          "type": "string",
          "const": "error"
        },
        {
          "description": "Keep the call, resolving it at runtime, and warn (W007).",
          "type": "string",
          "const": "warn"
        },
        {
          "description": "Keep the call without a warning, for trees where runtime requires are\nnormal, such as Roblox's `require(script.Parent.Child)`.",
          "type": "string",
          "const": "allow"
        }
      ]
    },
    "EntryConfig": {
      "description": "One entry of a multi-entry build: the file to bundle and where to write\nthe bundle, both relative to the `luck.json` directory.",
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "entry",
        "output"
      ]
    },
    "FormatConfig": {
      "description": "Formatter settings from luck.json.",
      "type": "object",
      "properties": {
        "block_newline_gaps": {
          "description": "Whether to keep a blank line at the start or end of a block body:\n`\"never\"` (default) or `\"preserve\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/BlockNewlineGaps"
            },
            {
              "type": "null"
            }
          ]
        },
        "call_parentheses": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallParentheses"
            },
            {
              "type": "null"
            }
          ]
        },
        "collapse_simple_statement": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollapseSimpleStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "hexadecimal_case": {
          "description": "Case of the hex digits `A`-`F` in numeric literals: `\"preserve\"`\n(default), `\"lower\"`, or `\"upper\"`. The `0x` prefix is always\nlowercase.",
          "anyOf": [
            {
              "$ref": "#/$defs/HexCase"
            },
            {
              "type": "null"
            }
          ]
        },
        "indent_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndentStyle"
            },
            {
              "type": "null"
            }
          ]
        },
        "indent_width": {
          "description": "Columns per indent level. With tabs, this is how wide a tab counts\nagainst `line_width`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "line_endings": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineEndings"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_width": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "magic_trailing_comma": {
          "description": "When true, a trailing comma in a table constructor breaks the table one\nfield per line, as in Black and Prettier. Defaults to `false`. Argument\nlists can't carry one, since no dialect allows a comma after the last\nargument.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "quote_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteStyle"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort_requires": {
          "description": "When true, sorts each run of consecutive `local NAME = require(...)`\nor `local NAME = game:GetService(...)` statements by name. A blank\nline ends a run.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "space_after_function_names": {
          "description": "Where to put a space before `(`: `\"never\"` (default), `\"definitions\"`,\n`\"calls\"`, or `\"always\"` for both.",
          "anyOf": [
            {
              "$ref": "#/$defs/SpaceAfterFunction"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HexCase": {
      "description": "Case of the hexadecimal digits `A`-`F` in numeric literals. The base\nprefix (`0x`, `0b`) and exponent markers (`e`, `p`) are always lowercase,\nso this setting only governs the digits.",
      "oneOf": [
        {
          "description": "Leave the author's digit case untouched (`0xB0` and `0xb0` both stand).",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "`0xB0` -> `0xb0`.",
          "type": "string",
          "const": "lower"
        },
        {
          "description": "`0xb0` -> `0xB0`.",
          "type": "string",
          "const": "upper"
        }
      ]
    },
    "IndentStyle": {
      "type": "string",
      "enum": [
        "tabs",
        "spaces"
      ]
    },
    "LineEndings": {
      "type": "string",
      "enum": [
        "unix",
        "windows"
      ]
    },
    "LintConfig": {
      "description": "Linter settings from luck.json.",
      "type": "object",
      "properties": {
        "categories": {
          "description": "A level per rule category. `\"warn\"` and `\"error\"` run every rule in the\ncategory at that severity, and `\"off\"` runs none of them. A category\nleft out keeps its default: `correctness` runs each rule at the rule's\nown severity, and the others are off.",
          "$ref": "#/$defs/CategoryLevels",
          "default": {}
        },
        "extra_globals": {
          "description": "Extra global names to treat as defined, such as `vim` or `love`.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "description": "A setting per rule, keyed by rule name: `\"off\"`, `\"warn\"`, or\n`\"error\"`, or `[level, options]` for a rule that takes options. It\nwins over the rule's category.",
          "$ref": "#/$defs/RuleSettings",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ProfileOverrides": {
      "description": "A build profile, selected with `luck build --profile <name>`.\n\nIts `minify` and `transforms` replace the top-level ones. `--release` and\n`--dev` select the `release` and `dev` profiles.",
      "type": "object",
      "properties": {
        "minify": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transforms": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransformConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "QuoteStyle": {
      "oneOf": [
        {
          "description": "Always use double quotes.",
          "type": "string",
          "const": "double"
        },
        {
          "description": "Always use single quotes.",
          "type": "string",
          "const": "single"
        },
        {
          "description": "Use double quotes, switching to single when that needs strictly\nfewer escaped quotes.",
          "type": "string",
          "const": "auto_prefer_double"
        },
        {
          "description": "Use single quotes, switching to double when that needs strictly\nfewer escaped quotes.",
          "type": "string",
          "const": "auto_prefer_single"
        }
      ]
    },
    "RestrictedModulePathsOptions": {
      "description": "Options of the `restricted_module_paths` rule.",
      "type": "object",
      "properties": {
        "paths": {
          "description": "Modules that can't be required. A trailing `.*` also covers\nsubmodules: `forbidden.*` matches `forbidden` and `forbidden.sub`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "paths"
      ]
    },
    "RuleLevel": {
      "description": "Whether a rule runs, and the severity of what it reports.",
      "type": "string",
      "enum": [
        "off",
        "warn",
        "error"
      ]
    },
    "RuleSetting_CyclomaticComplexityOptions": {
      "description": "One rule's entry in `rules`.",
      "anyOf": [
        {
          "description": "`\"off\"`, `\"warn\"`, or `\"error\"`.",
          "$ref": "#/$defs/RuleLevel"
        },
        {
          "description": "A level and the rule's options: `[level, options]`.",
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "$ref": "#/$defs/CyclomaticComplexityOptions"
            }
          ]
        }
      ]
    },
    "RuleSetting_RestrictedModulePathsOptions": {
      "description": "One rule's entry in `rules`.",
      "anyOf": [
        {
          "description": "`\"off\"`, `\"warn\"`, or `\"error\"`.",
          "$ref": "#/$defs/RuleLevel"
        },
        {
          "description": "A level and the rule's options: `[level, options]`.",
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RuleLevel"
            },
            {
              "$ref": "#/$defs/RestrictedModulePathsOptions"
            }
          ]
        }
      ]
    },
    "RuleSettings": {
      "description": "A level per rule, keyed by rule name. Only the rules listed here take\noptions.",
      "type": "object",
      "properties": {
        "cyclomatic_complexity": {
          "description": "Reports nothing until its options set `max`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSetting_CyclomaticComplexityOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "restricted_module_paths": {
          "description": "Reports nothing until its options list `paths`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSetting_RestrictedModulePathsOptions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/RuleLevel"
      }
    },
    "SpaceAfterFunction": {
      "description": "Where a space goes before the `(` of a function definition or call.",
      "oneOf": [
        {
          "description": "No space: `function foo()`, `foo()`.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Space before a definition's parameter list only: `function foo ()`.",
          "type": "string",
          "const": "definitions"
        },
        {
          "description": "Space between a callee and its `(` only: `foo ()`.",
          "type": "string",
          "const": "calls"
        },
        {
          "description": "Space in both definitions and calls.",
          "type": "string",
          "const": "always"
        }
      ]
    },
    "TransformConfig": {
      "description": "Turns individual minifier passes on or off. Every pass except\n`rename_globals` is on by default.",
      "type": "object",
      "properties": {
        "fold_constants": {
          "type": "boolean",
          "default": true
        },
        "inline_locals": {
          "type": "boolean",
          "default": true
        },
        "lift_locals": {
          "type": "boolean",
          "default": true
        },
        "merge_locals": {
          "type": "boolean",
          "default": true
        },
        "remove_dead_code": {
          "type": "boolean",
          "default": true
        },
        "rename_globals": {
          "description": "Rename globals this file defines, such as `function helper() end` or\n`counter = 0`. Off by default: renamed globals land under different\n`_G` keys, which breaks other chunks, `_G[\"name\"]` lookups, and loaded\nstrings that use the original names. Only takes effect with\n`rename_locals` on.",
          "type": "boolean",
          "default": false
        },
        "rename_locals": {
          "type": "boolean",
          "default": true
        },
        "shorten_numbers": {
          "type": "boolean",
          "default": true
        },
        "shorten_strings": {
          "type": "boolean",
          "default": true
        },
        "simplify_indexes": {
          "type": "boolean",
          "default": true
        },
        "simplify_parens": {
          "type": "boolean",
          "default": true
        },
        "simplify_statements": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
