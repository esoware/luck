---
source: crates/luck_bundler/tests/it/bundle.rs
expression: output
---
local __luck_modules={}
local __luck_loaded={}
local __luck_loading={}
local function __luck_result(...)
if select("#",...)~=1 then
error("luck bundle: module must return a single value",0)
end
return ...
end
local function __luck_require(id)
local value=__luck_loaded[id]
if value~=nil then return value end
local chunk=__luck_modules[id]
if __luck_loading[id] then
local level=2
local caller=debug.info(level,"f")
while caller do
if caller==chunk then
error("luck bundle: module #"..id.." was required recursively while it loads",2)
end
level+=1
caller=debug.info(level,"f")
end
end
__luck_loading[id]=true
value=__luck_result(chunk())
__luck_loading[id]=nil
__luck_loaded[id]=value
return value
end
-- module #1: d.lua
__luck_modules[1]=function(...)
local d = {
    base = 10
}

return d
end
-- module #2: b.lua
__luck_modules[2]=function(...)
local d = __luck_require(1)

local b = {}

function b.value()
    return d.base + 1
end

return b
end
-- module #3: c.lua
__luck_modules[3]=function(...)
local d = __luck_require(1)

local c = {}

function c.value()
    return d.base + 2
end

return c
end
local __luck_entry=function(...)
local b = __luck_require(2)
local c = __luck_require(3)

local result = b.value() + c.value()
print(result)
return result
end
return __luck_entry(...)
