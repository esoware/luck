warning: negated comparison, consider `a ~= b`
 --> Standalone:1:11
1 | local r = not (a == b)
  |           ^^^^^^^^^^^^
fix: invert the comparison operator
  | local r = a ~= b

warning: negated comparison, consider `a == b`
 --> Standalone:1:11
1 | local r = not (a ~= b)
  |           ^^^^^^^^^^^^
fix: invert the comparison operator
  | local r = a == b

warning: negated comparison, consider `a >= b`
 --> Standalone:1:11
1 | local r = not (a < b)
  |           ^^^^^^^^^^^

warning: negated comparison, consider `a < b`
 --> Standalone:1:11
1 | local r = not (a >= b)
  |           ^^^^^^^^^^^^

warning: negated comparison, consider `x.y == f(1)`
 --> Standalone:1:11
1 | local r = not (x.y ~= f(1))
  |           ^^^^^^^^^^^^^^^^^
fix: invert the comparison operator
  | local r = x.y == f(1)

